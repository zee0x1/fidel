{
  "name": "fidel",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "add:root": "pnpm add --workspace-root",
    "add:root:dev": "pnpm add --workspace-root --save-dev",
    "add:client": "pnpm --filter @fidel/client add",
    "add:client:dev": "pnpm --filter @fidel/client add --save-dev",
    "add:gateway": "pnpm --filter @fidel/gateway add",
    "add:gateway:dev": "pnpm --filter @fidel/gateway add --save-dev",
    "add:server": "uv add --directory apps/server",
    "add:server:dev": "uv add --directory apps/server --dev",
    "dev": "concurrently --kill-others --names server,gateway,client --prefix-colors blue,magenta,cyan \"pnpm dev:server\" \"pnpm dev:gateway\" \"pnpm dev:client\"",
    "dev:server": "uv run --directory apps/server uvicorn main:app --reload --port 8000",
    "dev:gateway": "pnpm --filter @fidel/gateway dev",
    "dev:client": "pnpm --filter @fidel/client dev",
    "build": "pnpm --recursive --if-present build && pnpm build:server",
    "build:client": "pnpm --filter @fidel/client build",
    "build:gateway": "pnpm --filter @fidel/gateway build",
    "build:server": "uv sync --directory apps/server --locked --no-dev",
    "check": "pnpm --recursive --if-present typecheck && pnpm check:server",
    "check:client": "pnpm --filter @fidel/client typecheck",
    "check:gateway": "pnpm --filter @fidel/gateway typecheck",
    "check:server": "uv run --directory apps/server python -m compileall -q main.py"
  },
  "devDependencies": {
    "concurrently": "latest"
  }
}
